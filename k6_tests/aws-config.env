# Configuración para pruebas de rendimiento en AWS
# Archivo: aws-config.env

# URLs del sistema desplegado en AWS
AWS_BASE_URL="https://your-colive-domain.com"
AWS_API_GATEWAY_URL="https://api.your-colive-domain.com"
AWS_AUTH_SERVICE_URL="https://auth.your-colive-domain.com"

# Configuración de red para AWS
AWS_REGION="us-east-1"
AWS_LOADBALANCER_URL="https://colive-lb-123456789.us-east-1.elb.amazonaws.com"

# Tokens de autenticación para AWS
# Obtener estos tokens haciendo login en el sistema de AWS
AWS_ADMIN_TOKEN="Bearer eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..."
AWS_VIGILANTE_TOKEN="Bearer eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..."

# IDs de conjuntos residenciales reales en AWS
AWS_CONJUNTO_1="real-conjunto-id-1"
AWS_CONJUNTO_2="real-conjunto-id-2"
AWS_CONJUNTO_3="real-conjunto-id-3"

# Configuración de pruebas para AWS
# Reducir carga inicial para no sobrecargar el sistema en producción
MAX_VUS_AWS=50
RAMP_UP_TIME_AWS="5m"

# Umbrales más estrictos para producción
AWS_ERROR_RATE_THRESHOLD=0.05  # 5% máximo
AWS_RESPONSE_TIME_P95=2000     # 2 segundos máximo

# Configuración de SSL/TLS
VERIFY_SSL=true
SSL_CERT_PATH=""  # Dejar vacío para usar certificados del sistema
